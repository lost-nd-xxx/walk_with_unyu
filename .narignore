# nar を作るときに除外するファイル（gitignore の書式）。
# SSP と ukagaka-developer の build-nar.ps1 が使う。.updateignore もこのファイルを取り込む。
# https://ssp.shillest.net/ukadoc/manual/descript_install.html

# AI エージェント（ukagaka-developer スキル）と開発用のファイル
/AGENTS.md
/CLAUDE.md
/GHOST.md
/.mcp.json
/.claude/
/.agents/
/build/
/_workspace/

# sstp.ps1 -Balloon の吹き出し画像（スクリプトを途中で止めたときだけ残る）
/ghost/master/devkit-balloon-*/

# リポジトリとエディタのファイル
.git
.gitmodules
.gitignore
.gitattributes
.editorconfig
/.narignore
/.updateignore

# ネットワーク更新でだけ使う（.updateignore で戻す）
/delete.txt

# ネットワーク更新ファイル（配布サーバーに置くもの）
updates2.dau
updates.txt

# 実行時に作られるもの
profile/
yaya_variable.cfg

# システム辞書のうち、動作に要らないもの（lint.dic は dicif なので、無くても読み込みエラーにならない）
/ghost/master/dic/system/docs/
/ghost/master/dic/system/LICENSE
/ghost/master/dic/system/README.md
/ghost/master/dic/system/yaya_base/lint.dic
*.yaya-dic-new
