//******************************************************************************
// YAYA　ゴーストテンプレート
// 起動/終了トーク辞書
//******************************************************************************

//********************************
//起動時の一時変数の削除など
//********************************

OnSystemLoad.RemoveTempVar
{
	ERASEVAR('unyu_running')
	ERASEVAR('unyu_starttick')
	ERASEVAR('unyu_limitmin')
	ERASEVAR('unyu_basesize')
	ERASEVAR('unyu_count')
	ERASEVAR('unyu_nextnotice')
	ERASEVAR('unyu_lasttick')
	ERASEVAR('unyu_saidsave')
}

//******************************************************************************
//初回起動 OnFirstBoot
//******************************************************************************

OnFirstBoot
{
	//---- 変数の初期化
	username         = 'ユーザさん'

	//---- 作業セッションの変数を用意する
	UnyuSessionInit

	'\0\s[0]初めまして。\w9\nワイは作業応援うにゅうやで。\w9\n作業を始めるときは、\w5ワイをつついてな。\e'
}


//******************************************************************************
//通常の起動 OnBoot
//******************************************************************************

OnBoot
{
	//---- 作業セッションの変数を用意する
	UnyuSessionInit

	//---- まず双方のサーフィスを表示
	'\1\s[10]\0\s[0]'
	--
	//---- 起動時間を確認してあいさつを変化
	_timeslot = GetTimeSlot

	case _timeslot{
		when '朝'{
			'おはよう。\w9朝の作業か？'
			'今日も一日、\w5ゆるゆる行こな～。'
			"おはようさん、\w5%(username)。\w9\nワイはまだ座っとるけどな。"
			'おはよう。\w9\n朝は、\w5頭が一番よう回る時間らしいで。\w9\n知らんけど。'
			'ん、\w5起きたか。\w9\nワイはずっとここにおったで。'
		}
		when '昼'{
			"こんちゃーす、\w5%(username)。"
			'お昼やな。\w9\nちゃんと食うたか？'
			"こんにちは。\w9\n%(username)、\w5午後もぼちぼちやろか。"
		}
		when '日中'{
			"こんちゃーす、\w5%(username)。"
			'この時間はな、\w5一番眠とうなるらしいで。\w9\n無理せんときや。'
			"お、\w5来たな。\w9\n%(username)、\w5今日はどこまでやる？"
		}
		when '夜'{
			'こんばわ～。\w9これから作業か？'
			'晩やな。\w9\n今日の分、\w5まだ残っとるんか？'
			"おかえり、\w5%(username)。\w9\n夜はよう捗る言うけど、\w5ほどほどにな。"
		}
		others{
			//それ以外の時間の場合(深夜)
			'これから作業か？\w9\nご苦労さん。'
			'こんな時間まで、\w5ようやるわ。\w9\n…\w5…\w5人のこと言えんけどな。'
			"%(username)、\w5そろそろ寝る時間とちゃうか。\w9\nまあ、\w5言うても聞かんやろけど。"
			'深夜か。\w9\n静かでええな。\w9\nワイの足音くらいしかせんわ。'
		}
	}//caseの終わり
	--
	'\e'
}

//------------------------------------------------------------------------------
//朝/昼/夜などをおおざっぱに調べる関数
//------------------------------------------------------------------------------
GetTimeSlot
{
	case hour{
		when 22,23,0,1,2,3 {'深夜'}
		when 4,5,6,7,8,9,10,11 {'朝'}
		when 12,13 {'昼'}
		when 14,15,16,17 {'日中'}
		when 18,19,20,21 {'夜'}
	}//caseの終わり
}


//******************************************************************************
//終了 OnClose
//******************************************************************************

OnClose
{
	'\1\s[10]\0\s[0]'
	--
	//この部分には\eをつけない
	_timeslot = GetTimeSlot

	if _timeslot == '朝'{
		//---- 朝に終了
		'これから一日の始まりやね。\w9またな。'
		'ほな、\w5行ってらっしゃい。'
		'朝から気ぃつけてな。\w9\nワイは留守番しとくわ。'
	}
	elseif _timeslot == "昼" || _timeslot == "日中"{
		//---- 昼/日中に終了
		'ワイは昼寝でもしよかな。'
		'ほな、\w5またあとでな。'
		'ちょっと休憩か。\w9\nええこっちゃ。'
	}
	elseif _timeslot == '夜'{
		//---- 夜に終了
		'おやすみやで。'
		'今日はここまでか。\w9\nお疲れさん。'
		"ほな、\w5また明日な。\w9\n%(username)もゆっくり休みや。"
	}
	else{
		//---- 深夜に終了
		'おやすみやで。'
		'やっと寝るんか。\w9\nそのほうがええわ。'
		'おつかれさん。\w9\n夢でも歩いとくわ。'
	}
	--
	//文章を読む時間を確保してから終了　`\-`は単体終了
	'\w9\w9\-\e'
}


//******************************************************************************
//最小化からの復帰 OnWindowStateRestore
//******************************************************************************

OnWindowStateRestore
{
	OnSurfaceRestore
}
