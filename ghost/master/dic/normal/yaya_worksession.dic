//******************************************************************************
// 作業応援うにゅう
// 作業セッション辞書
//
// SSP のファイル監視（\![execute,filewatch]）と YAYA の FSIZE を使い、
// 一定時間の作業を見守って、終わりに更新回数とファイルサイズの変化を報告する。
//
// 保存する変数（次回も使う設定）
//   unyu_watchpaths 監視するファイルのパス（4 つまで）。| でつないだ 1 つの文字列（| はパスに使えない）
//                   読み書きは UnyuWatchList / UnyuWatchListSet を通す。
//                   以前の 1 ファイルだけの unyu_watchpath は、読み込むときにこちらへ移す
//   unyu_sound     効果音を鳴らすなら 1。最初は 0（鳴らさない）
//   unyu_single_min 1 回だけのときの作業時間（分）。最初は 25
//   unyu_pomo_work  ポモドーロの作業時間（分）
//   unyu_pomo_break ポモドーロの休憩時間（分）
//   unyu_pomo_long  ポモドーロの長い休憩（分）
//   unyu_pomo_sets  長い休憩までの作業の回数
//
// 終了時に破棄する変数（ゴーストを終了したらセッションは残さない）
//   unyu_running    走行中なら 1（ポモドーロでは休憩中も 1）
//   unyu_mode       'single'（1 回だけ）か 'pomo'（ポモドーロ）
//   unyu_phase      'work'（歩いている）、'break'（休憩中）、'wait'（休憩明けの確認待ち）
//   unyu_starttick  開始時の GETTICKCOUNT（ミリ秒）
//   unyu_limitmin   今回の作業時間（分）。ポモドーロでは 1 回ぶんの作業時間
//   unyu_watchfiles 今回見ているファイルのパス（配列）。開始時に unyu_watchpaths から写す
//   unyu_filealive  ファイルごとに、まだ見られているなら 1（配列。見えなくなったファイルは 0）
//   unyu_filecounts ファイルごとの更新回数（配列。いちばん動いたファイルを言うのに使う）
//   unyu_filegone   ファイルごとに、deleted が来た GETTICKCOUNT（配列。来ていなければ 0）
//   unyu_basesize   開始時のファイルサイズ（バイト。配列）。取れなければ -1
//   unyu_count      監視中に数えた更新回数。全ファイルの合計（休憩中の保存は数えない）
//   unyu_nextnotice 次に中間報告をする経過分（1 回だけのときのみ）
//   unyu_lasttick   最後にファイルが変わった GETTICKCOUNT。まだ無ければ作業を始めた時刻
//   unyu_saidsave   保存忘れを言った後なら 1。次に保存されると 0 に戻る
//   ---- ここからポモドーロだけで使う
//   unyu_phasetick  今の作業または休憩を始めた GETTICKCOUNT
//   unyu_cycle      何回目の作業か（1 から）
//   unyu_cyclecount 今の作業で数えた更新回数
//   unyu_cyclebase  今の作業を始めたときのファイルサイズ（配列）。取れなければ -1
//   unyu_worktotal  終わった作業の合計（分）
//   unyu_breakmin   今の休憩の長さ（分）
//   unyu_breaksave  休憩中の保存。0 なし、1 見つけた（まだ言っていない）、2 言った
//   ---- ここから見るファイルの画面で使う
//   unyu_inwatchmenu 見るファイルの画面から入力ボックスを開いたなら 1（入力の後にその画面へ戻る）
//   unyu_editindex   入力ボックスで差し替えるファイルの番号。足すときは -1
//   unyu_dropscreen  ドロップでファイルを足せる画面（作業準備・ポモドーロの設定・見るファイル）を出したなら 1
//******************************************************************************

//------------------------------------------------------------------------------
// 辞書を読み込むたびに（起動のほか、再読み込みでも）準備する
// OnBoot は再読み込みでは来ないので、そこには置かない。
// システム辞書の load は、一時変数の登録を空にしてから OnSystemLoad.* を名前順に呼ぶ。
// OnSystemLoad.RemoveTempVar（前回の一時変数を消す）のほうが先に呼ばれる
//------------------------------------------------------------------------------
OnSystemLoad.UnyuSession
{
	UnyuSessionInit
}

//------------------------------------------------------------------------------
// 一時変数の登録（終了時に自動で消える）と、保存する設定の初期値
// 保存する変数は登録しない
//------------------------------------------------------------------------------
UnyuSessionInit
{
	SHIORI3FW.RegisterTempVar('unyu_running','unyu_mode','unyu_phase','unyu_starttick','unyu_limitmin','unyu_watchfiles','unyu_filealive','unyu_filecounts','unyu_filegone','unyu_basesize','unyu_count','unyu_nextnotice','unyu_lasttick','unyu_saidsave','unyu_phasetick','unyu_cycle','unyu_cyclecount','unyu_cyclebase','unyu_worktotal','unyu_breakmin','unyu_breaksave','unyu_inwatchmenu','unyu_editindex','unyu_dropscreen')

	if !ISVAR('unyu_running') {
		unyu_running = 0
	}
	if !ISVAR('unyu_phase') {
		unyu_phase = ''
	}
	unyu_inwatchmenu = 0
	unyu_editindex   = -1
	unyu_dropscreen  = 0

	//---- 見るファイル。以前の 1 ファイルだけの設定（unyu_watchpath）があれば移す
	if !ISVAR('unyu_watchpaths') {
		unyu_watchpaths = ''
	}
	if ISVAR('unyu_watchpath') {
		if STRLEN(unyu_watchpaths) == 0 {
			unyu_watchpaths = unyu_watchpath
		}
		ERASEVAR('unyu_watchpath')
	}
	if !ISVAR('unyu_single_min') {
		unyu_single_min = 25
	}
	if !ISVAR('unyu_sound') {
		unyu_sound = 0
	}
	foreach ('work','break','long','sets') ; _key {
		if !ISVAR('unyu_pomo_' + _key) {
			LETTONAME('unyu_pomo_' + _key,UnyuPomoDefault(_key))
		}
	}
}

//------------------------------------------------------------------------------
// 作業中（歩いている）なら 1。ポモドーロの休憩中は 0
//------------------------------------------------------------------------------
UnyuWalking
{
	unyu_running && unyu_phase == 'work'
}

//------------------------------------------------------------------------------
// 走行中のダブルクリックと m キー。今の場面に合わせて振り分ける
//------------------------------------------------------------------------------
UnyuRunningMenu
{
	if unyu_phase == 'break' {
		UnyuPomoBreakReport
	}
	elseif unyu_phase == 'wait' {
		UnyuPomoNextAsk('休憩は、\w5もう終わっとるで。\w9\n')
	}
	else {
		UnyuProgressReport
	}
}

//******************************************************************************
// 効果音
//******************************************************************************

//------------------------------------------------------------------------------
// 効果音のタグ。鳴らさない設定なら空
// _argv[0] は 'start'（歩き出すとき）か 'end'（作業が終わったとき）
// \_v のパスは ghost/master からの相対。区切りは / にする（\ はタグになる）
//------------------------------------------------------------------------------
UnyuSound
{
	if !unyu_sound {
		return ''
	}
	UnyuSoundTag(_argv[0])
}

//---- 設定に関わらず、その音を鳴らすタグ（試聴用）
UnyuSoundTag
{
	"\_v[sound/sound_%(_argv[0]).wav]\![sound,wait]"
}

//******************************************************************************
// 開始のきっかけ（OpenMenuから呼ばれる）
//******************************************************************************

//---- _argv[0] に台詞を渡すと、最初の一言（「ほな、始めよか。」）の代わりにそれを言う
//---- （入力や設定を変えた後に、この画面へ戻ってくるとき用）
//---- 見るファイルと音は、ポモドーロの設定画面と同じく、今の値を選択肢そのものに出す
UnyuWorkMenu
{
	//---- 時間はまだ選んでいない。前回のセッションの値を残さない
	//---- unyu_mode は、入力の後にどちらの画面へ戻るかの目印にもなる（UnyuBackToSetup）
	unyu_limitmin    = 0
	unyu_mode        = 'single'
	unyu_inwatchmenu = 0
	unyu_dropscreen  = 1

	'\0\s[0]\![quicksection,1]'
	--
	if _argc > 0 {
		_argv[0]
	}
	else {
		'ほな、始めよか。'
	}
	--
	//---- 選んである時間で始める。時間の選択肢は選ぶだけで、始めない
	UnyuShortMenuItem("%(HAN2ZEN(unyu_single_min,'num'))分で始める","UnyuStartSingle",150)
	--
	UnyuShortMenuItem("ポモドーロでいく","UnyuPomoMenu",0)
	--
	//---- 時間は 2 列に並べる。選んである時間は太字にする
	'\n[150]'
	--
	UnyuTimeItem(15,'UnyuPick15')
	--
	UnyuTimeItem(25,'UnyuPick25')
	--
	UnyuTimeItem(45,'UnyuPick45')
	--
	UnyuTimeItem(60,'UnyuPick60')
	--
	AYATEMPLATE.MenuItem("時間を自分で決める","UnyuAskMinutes",100)
	--
	UnyuSoundSetupItem(100)
	--
	UnyuWatchFileSetupItem
	--
	AYATEMPLATE.MenuItem("やっぱやめとく","UnyuCancelMenu",150)
	--
	'\![quicksection,0]\e'
}

//------------------------------------------------------------------------------
// 灰色（無効表示と同じ色）で出す選択肢。押すことはできる。引数は UnyuShortMenuItem と同じ
// \q[...] の文字には色を付けられないので、\__q[関数名]文字\__q の形で作る
// こちらは文字がスクリプトとして解釈されるので、AYATEMPLATE.EscapeText ではなく EscapeAllTags を通す
//------------------------------------------------------------------------------
UnyuDimMenuItem
{
	_text  = _argv[0]
	_width = 20
	if _argc > 3 {
		_width = _argv[3]
	}
	if _width > 0 {
		_text = SHIORI3FW.MakeJustText(_text,_width)
	}

	_lftext   = ''
	_linefeed = _argv[2]
	while _linefeed > 0 {
		if _linefeed >= 100 {
			_lftext += '\n'
		}
		else {
			_lftext += '\n[half]'
		}
		_linefeed -= 100
	}

	_lftext + '\![*]\__q[' + _argv[1] + ']\f[disable]' + SHIORI3FW.EscapeAllTags(_text) + '\f[default]\__q'
}

//------------------------------------------------------------------------------
// 横に並べる用の、幅の狭い選択肢（全角 10 字ぶん）
// _argv[2] は改行の量。AYATEMPLATE.MenuItem と同じく 100 で 1 行、50 で半行、0 なら改行しない
// _argv[3] は幅（半角 1・全角 2 の単位。省略すると 20）。0 なら幅をそろえない（右端の列用）
// 幅より長い文字は MakeJustText に切り詰められるので、長くなりうる項目は右端に置いて 0 にする
//------------------------------------------------------------------------------
UnyuShortMenuItem
{
	_text  = _argv[0]
	_width = 20
	if _argc > 3 {
		_width = _argv[3]
	}
	if _width > 0 {
		_text = SHIORI3FW.MakeJustText(_text,_width)
	}

	_lftext   = ''
	_linefeed = _argv[2]
	while _linefeed > 0 {
		if _linefeed >= 100 {
			_lftext += '\n'
		}
		else {
			_lftext += '\n[half]'
		}
		_linefeed -= 100
	}

	_lftext + '\![*]\q[' + AYATEMPLATE.EscapeText(_text) + ',' + _argv[1] + ']'
}

//------------------------------------------------------------------------------
// 作業準備画面とポモドーロの設定画面に共通の項目
// どちらの画面から来たかは unyu_mode で見分ける（UnyuWorkMenu が 'single'、UnyuPomoMenu が 'pomo' にする）
//------------------------------------------------------------------------------

//---- 今いる設定の画面に、一言添えて戻す
UnyuBackToSetup
{
	if unyu_mode == 'pomo' {
		UnyuPomoMenu(_argv[0])
	}
	else {
		UnyuWorkMenu(_argv[0])
	}
}

//---- 音の項目。左に今の状態（選ぶたびに切り替わる）、右に「試聴」を並べる。_argv[0] は改行の量
UnyuSoundSetupItem
{
	_label = '音: 鳴らさない'
	if unyu_sound {
		_label = '音: 鳴らす'
	}

	UnyuShortMenuItem(_label,"UnyuSetupSoundToggle",_argv[0])
	--
	UnyuShortMenuItem("試聴","UnyuSetupSoundPreview",0)
}

//---- メインメニューの「効果音を鳴らして」と同じ設定。切り替えるだけで、音は鳴らさない（聞くのは「試聴」）
UnyuSetupSoundToggle
{
	unyu_sound = !unyu_sound

	if unyu_sound {
		UnyuBackToSetup('ほな、鳴らすで。')
	}
	else {
		UnyuBackToSetup('ほな、音は止めとくわ。')
	}
}

//---- 2 つの音を順に聞かせて、元の画面に戻す。鳴らす設定かどうかに関わらず鳴らす
//---- \_V で鳴り終わるのを待ってから次へ進むので、選択肢は音が終わってから出る
UnyuSetupSoundPreview
{
	UnyuBackToSetup('\![quicksection,0]歩き出すときはこれで、' + UnyuSoundTag('start') + '終わったときはこれや。' + UnyuSoundTag('end') + '\![quicksection,1]' )
}

//---- 見るファイルの項目。1 つ目の名前と、ほかにいくつあるかを出す
//---- まだ無いときは、見るファイルの画面を通さずに、すぐ聞く
UnyuWatchFileSetupItem
{
	_list = UnyuWatchList
	_n    = ARRAYSIZE(_list)

	if _n <= 0 {
		return AYATEMPLATE.MenuItem("見るファイルを決める","UnyuAskPathAdd",100)
	}

	//---- 見当たらないファイルがあれば、名前の代わりに数を出して印を付ける
	//---- （始めるまで気づかない、ということがないように。名前と印を両方出すと長すぎて切り詰められる）
	_missing = 0
	foreach _list ; _path {
		if !UnyuWatchExists(_path) {
			_missing += 1
		}
	}

	//---- ローカル変数は { } の外で作っておく（中で作ると外で消える）
	_text = "見るファイル: 「%(UnyuWatchFileName(_list[0]))」"
	if _missing > 0 {
		_text = "見るファイル: %(HAN2ZEN(_n,'num'))つ（" + UnyuMissingWord + 'あり）'
	}
	else {
		if _n > 1 {
			_text += "ほか%(HAN2ZEN(_n - 1,'num'))つ"
		}
	}
	AYATEMPLATE.MenuItem(_text,"UnyuWatchMenu",100)
}

//------------------------------------------------------------------------------
// ファイルの名前（フォルダを除く）。選択肢に出す用。_argv[0] はパス
// 選択肢の文字は AYATEMPLATE.EscapeText で囲まれるので、ここではエスケープしない
// 台詞に出すときは SHIORI3FW.EscapeAllTags を通す（UnyuWatchFileTalkName）
// 長すぎるときは、頭だけ残して「（略）」を付ける。幅は全角 1、半角 0.5 で数える
// 「見るファイル: 「」ほか３つ」と合わせて、全角 24 文字ぶんくらいに収まるようにしている
//   名前（拡張子を除く）: 全角 10 文字ぶんを超えたら、7 文字ぶんまで縮める
//   拡張子              : 基本的に省略しない。全角 5 文字ぶん（半角 10 文字）を超えたときだけ縮める
//------------------------------------------------------------------------------
UnyuWatchFileName
{
	_parts = SPLITPATH(_argv[0])

	UnyuShorten(_parts[2],10,7) + UnyuShorten(_parts[3],5,3)
}

//---- 台詞に出す用。ファイル名に \ や % が入っていてもタグとして解釈されないようにする
UnyuWatchFileTalkName
{
	SHIORI3FW.EscapeAllTags(UnyuWatchFileName(_argv[0]))
}

//******************************************************************************
// 見るファイルの一覧（4 つまで）
//******************************************************************************

//------------------------------------------------------------------------------
// 見るファイルの上限
//------------------------------------------------------------------------------
UnyuWatchMax
{
	4
}

//------------------------------------------------------------------------------
// 保存してある見るファイルを配列で返す（空の要素は除く）
//------------------------------------------------------------------------------
UnyuWatchList
{
	_list = IARRAY
	foreach SPLIT(unyu_watchpaths,'|') ; _path {
		if STRLEN(_path) > 0 {
			_list ,= _path
		}
	}
	_list
}

//------------------------------------------------------------------------------
// 見るファイルを保存する。_argv に配列を渡す
//------------------------------------------------------------------------------
UnyuWatchListSet
{
	_text = ''
	for _i = 0 ; _i < _argc ; _i++ {
		if STRLEN(_argv[_i]) > 0 {
			if STRLEN(_text) > 0 {
				_text += '|'
			}
			_text += _argv[_i]
		}
	}
	unyu_watchpaths = _text
}

//------------------------------------------------------------------------------
// ファイルが今あるなら 1。FSIZE は失敗すると -1 を返す
// 見当たらないファイルも一覧からは消さない（同期の途中や、外付けのドライブを抜いているだけかもしれない）
// 消すかどうかは、見るファイルの画面の「外す」でユーザーが決める
//------------------------------------------------------------------------------
UnyuWatchExists
{
	FSIZE(_argv[0]) >= 0
}

//---- 見当たらないファイルに付ける言葉（一覧の画面では「（迷子）」、設定画面では「（迷子あり）」）
UnyuMissingWord
{
	'迷子'
}

//------------------------------------------------------------------------------
// 保存してある見るファイルのうち、今あるものを配列で返す
//------------------------------------------------------------------------------
UnyuWatchListExisting
{
	_list = IARRAY
	foreach UnyuWatchList ; _path {
		if UnyuWatchExists(_path) {
			_list ,= _path
		}
	}
	_list
}

//------------------------------------------------------------------------------
// 保存してある見るファイルのうち、見当たらないものの名前を、台詞に使える形の配列で返す
//------------------------------------------------------------------------------
UnyuWatchMissingNames
{
	_names = IARRAY
	foreach UnyuWatchList ; _path {
		if !UnyuWatchExists(_path) {
			_names ,= UnyuWatchFileTalkName(_path)
		}
	}
	_names
}

//------------------------------------------------------------------------------
// 名前の配列を「「a」と「b」」の形の文字列にする
//------------------------------------------------------------------------------
UnyuJoinNames
{
	_text = ''
	for _i = 0 ; _i < _argc ; _i++ {
		if _i > 0 {
			_text += 'と'
		}
		_text += '「' + _argv[_i] + '」'
	}
	_text
}

//------------------------------------------------------------------------------
// 見るファイルの画面（作業準備画面・ポモドーロの設定画面の「見るファイル」から）
// 名前を選ぶとそのファイルを差し替え、右の「外す」で外す
// _argv[0] に台詞を渡すと、最初の一言の代わりにそれを言う（末尾に \n を付けない）
//------------------------------------------------------------------------------
UnyuWatchMenu
{
	unyu_inwatchmenu = 1
	unyu_dropscreen  = 1

	_list = UnyuWatchList
	_n    = ARRAYSIZE(_list)

	'\0\s[0]\![quicksection,1]'
	--
	if _argc > 0 {
		_argv[0]
		--
		'\n'
	}
	--
	if _n <= 0 {
		'見るファイルは、まだ決まっとらんな。'
	}
	else {
		"今見とるんは、この%(HAN2ZEN(_n,'num'))つや。"
	}
	--
	//---- ドロップで足せることを知らせる（この画面を開いている間だけ足せる。OnFileDrop2）
	if _n < UnyuWatchMax {
		'\nファイルをワイに落としても、足せるで。'
	}
	--
	//---- 見当たらないファイルは灰色にして、印を付ける（押せば今までどおり差し替えられる）
	//---- 印のぶん名前が長くなるので、そのときは左の列を広げる（狭いと MakeJustText が切り詰める）
	_width = 32
	for _i = 0 ; _i < _n ; _i++ {
		if !UnyuWatchExists(_list[_i]) {
			_width = 40
		}
	}

	_items = ''
	for _i = 0 ; _i < _n ; _i++ {
		_linefeed = 100
		if _i == 0 {
			_linefeed = 150
		}
		if UnyuWatchExists(_list[_i]) {
			_items += UnyuShortMenuItem(UnyuWatchFileName(_list[_i]),"UnyuWatchEdit%(_i)",_linefeed,_width)
		}
		else {
			_items += UnyuDimMenuItem(UnyuWatchFileName(_list[_i]) + '（' + UnyuMissingWord + '）',"UnyuWatchEdit%(_i)",_linefeed,_width)
		}
		_items += UnyuShortMenuItem('外す',"UnyuWatchRemove%(_i)",0,0)
	}
	_items
	--
	if _n <= 0 {
		AYATEMPLATE.MenuItem("ファイルを足す","UnyuAskPathAdd",150)
	}
	elseif _n < UnyuWatchMax {
		AYATEMPLATE.MenuItem("ファイルを足す","UnyuAskPathAdd")
	}
	else {
		"\n\![*]\f[disable]ファイルを足す（%(HAN2ZEN(UnyuWatchMax,'num'))つまで）\f[default]"
	}
	--
	AYATEMPLATE.MenuItem("戻る","UnyuWatchBack",150)
	--
	'\![quicksection,0]\e'
}

//******************************************************************************
// ドラッグ＆ドロップでファイルを足す
//
// 受け付けるのは、設定の画面（作業準備・ポモドーロの設定・見るファイル）を開いている間だけ。
// それ以外は空を返して、SSP のいつもの処理（.nar のインストール、画像や音声を開く、など）に任せる。
// ゴーストが応答しなければ SSP が処理する（UKADOC: OnArchiveViewerOpen などの説明）。
//
// reference[0] ドロップされたパス。いくつも落とされたときはバイト値 1 で区切られる
// reference[1] 落とされたキャラクターのスコープ番号
// reference[2] MIME タイプ（同じく区切られる）
//******************************************************************************

OnFileDrop2
{
	if !UnyuDropAccepting {
		return
	}

	_paths = SPLIT(reference[0],CHR(1))

	//---- ゴーストなどの .nar は、受付中でも SSP のインストールに任せる
	foreach _paths ; _path {
		if TOLOWER(SPLITPATH(_path)[3]) == '.nar' {
			return
		}
	}

	UnyuDropAdd(_paths)
}

//------------------------------------------------------------------------------
// 今ドロップを受け付けるなら 1
// 設定の画面を出したときに unyu_dropscreen を立て、ほかの選択肢の画面（メインメニューなど）で下ろす。
// 画面が閉じたかどうかは、SSP が毎回のイベントに付ける Status ヘッダ（システム辞書の変数 status）に
// choosing（選択肢を出している最中）があるかで見る。閉じた後の印の下ろし忘れはこれで防げる
//------------------------------------------------------------------------------
UnyuDropAccepting
{
	!unyu_running && unyu_dropscreen && ('choosing' _in_ status)
}

//------------------------------------------------------------------------------
// ドロップされたパス（_argv）を足して、結果を言いながら見るファイルの画面を出す
// 足せないものは理由ごとに分けて伝える。足せるだけ足す
//------------------------------------------------------------------------------
UnyuDropAdd
{
	_list    = UnyuWatchList
	_added   = IARRAY
	_dup     = IARRAY
	_folder  = IARRAY
	_missing = IARRAY
	_over    = IARRAY

	for _i = 0 ; _i < _argc ; _i++ {
		_path = _argv[_i]
		if STRLEN(_path) <= 0 {
			continue
		}
		_name = SHIORI3FW.EscapeAllTags(UnyuWatchFileName(_path))

		//---- フォルダは見ない（どのファイルが変わったか分からないため）。FSIZE はフォルダだと -1
		_attr = FATTRIB(_path)
		if GETTYPE(_attr) == 4 && _attr[2] {
			_folder ,= _name
			continue
		}
		if FSIZE(_path) < 0 {
			_missing ,= _name
			continue
		}

		_known = 0
		foreach _list ; _p {
			if TOLOWER(_p) == TOLOWER(_path) {
				_known = 1
			}
		}
		if _known {
			_dup ,= _name
			continue
		}

		if ARRAYSIZE(_list) >= UnyuWatchMax {
			_over ,= _name
			continue
		}

		_list  ,= _path
		_added ,= _name
	}

	if ARRAYSIZE(_added) > 0 {
		UnyuWatchListSet(_list)
	}

	//---- 結果をまとめて言う
	_talk = ''
	if ARRAYSIZE(_added) > 0 {
		_talk += "%(UnyuJoinNames(_added))を足したで。"
	}
	if ARRAYSIZE(_dup) > 0 {
		_talk += UnyuDropSep(_talk) + "%(UnyuJoinNames(_dup))は、\w5もう見とるで。"
	}
	if ARRAYSIZE(_over) > 0 {
		_talk += UnyuDropSep(_talk) + "%(HAN2ZEN(UnyuWatchMax,'num'))つまでやから、\w5%(UnyuJoinNames(_over))は足されへんかったわ。"
	}
	if ARRAYSIZE(_folder) > 0 {
		_talk += UnyuDropSep(_talk) + "フォルダは見られへんから、\w5%(UnyuJoinNames(_folder))は足してへんで。"
	}
	if ARRAYSIZE(_missing) > 0 {
		_talk += UnyuDropSep(_talk) + "%(UnyuJoinNames(_missing))は、\w5見つからんかったわ。"
	}
	if STRLEN(_talk) <= 0 {
		_talk = 'ん？\w5なんも足されへんかったわ。'
	}

	UnyuWatchMenu(_talk)
}

//---- 結果の文をつなぐ区切り（最初の文の前には付けない）
UnyuDropSep
{
	if STRLEN(_argv[0]) > 0 {
		'\w9\n'
	}
	else {
		''
	}
}

//---- 元の設定画面に戻る
UnyuWatchBack
{
	unyu_inwatchmenu = 0
	--
	UnyuBackToSetup('ほな、これで見とくで。')
}

//---- 選択肢から呼ぶ関数は名前で決まるので、番号ごとに用意する（UnyuWatchMax と数を合わせる）
UnyuWatchEdit0
{
	UnyuAskPathEdit(0)
}

UnyuWatchEdit1
{
	UnyuAskPathEdit(1)
}

UnyuWatchEdit2
{
	UnyuAskPathEdit(2)
}

UnyuWatchEdit3
{
	UnyuAskPathEdit(3)
}

UnyuWatchRemove0
{
	UnyuWatchRemove(0)
}

UnyuWatchRemove1
{
	UnyuWatchRemove(1)
}

UnyuWatchRemove2
{
	UnyuWatchRemove(2)
}

UnyuWatchRemove3
{
	UnyuWatchRemove(3)
}

//---- _argv[0] 番目のファイルを外して、見るファイルの画面に戻す
UnyuWatchRemove
{
	_list = UnyuWatchList
	_i    = _argv[0]

	//---- 古い選択肢を押されたときは、何もせずに画面を出し直す
	if _i >= ARRAYSIZE(_list) {
		return UnyuWatchMenu
	}

	_name = UnyuWatchFileTalkName(_list[_i])
	_rest = IARRAY
	for _j = 0 ; _j < ARRAYSIZE(_list) ; _j++ {
		if _j != _i {
			_rest ,= _list[_j]
		}
	}
	UnyuWatchListSet(_rest)
	--
	UnyuWatchMenu("「%(_name)」は外したで。")
}

//------------------------------------------------------------------------------
// _argv[0] の幅が全角 _argv[1] 文字ぶんを超えたら、_argv[2] 文字ぶんまで縮めて「（略）」を付ける
// 1〜2 文字だけ削っても意味がないので、超えたときは一気に縮める
//------------------------------------------------------------------------------
UnyuShorten
{
	_text = _argv[0]
	if UnyuTextUnits(_text) > _argv[1] * 2 {
		UnyuTextCut(_text,_argv[2] * 2) + '（略）'
	}
	else {
		_text
	}
}

//------------------------------------------------------------------------------
// 文字列の幅を、半角 1・全角 2 の単位で返す
//------------------------------------------------------------------------------
UnyuTextUnits
{
	_units = 0
	for _i = 0 ; _i < STRLEN(_argv[0]) ; _i++ {
		_units += UnyuCharUnits(CHRCODE(_argv[0],_i))
	}
	_units
}

//------------------------------------------------------------------------------
// 文字列の頭から、幅が _argv[1]（半角 1・全角 2 の単位）に収まるところまでを返す
//------------------------------------------------------------------------------
UnyuTextCut
{
	_units = 0
	_len   = 0
	for _i = 0 ; _i < STRLEN(_argv[0]) ; _i++ {
		_units += UnyuCharUnits(CHRCODE(_argv[0],_i))
		if _units > _argv[1] {
			break
		}
		_len = _i + 1
	}
	SUBSTR(_argv[0],0,_len)
}

//------------------------------------------------------------------------------
// 1 文字（UTF-16 の 1 単位）の幅。半角 1・全角 2
// 絵文字などのサロゲートペアは、前半を 2、後半を 0 と数える
// （後半が 0 なので、UnyuTextCut がペアの途中で切ることはない）
//------------------------------------------------------------------------------
UnyuCharUnits
{
	_c = _argv[0]
	if _c < 128 {
		1    // ASCII
	}
	elseif _c >= 65377 && _c <= 65439 {
		1    // 半角カナ（U+FF61〜U+FF9F）
	}
	elseif _c >= 56320 && _c <= 57343 {
		0    // サロゲートペアの後半（U+DC00〜U+DFFF）
	}
	else {
		2
	}
}

//------------------------------------------------------------------------------
// 時間の選択肢（2 列の 1 つぶん）。選んである時間なら太字にする
// _argv[0] は分、_argv[1] は選んだときに呼ぶ関数
//------------------------------------------------------------------------------
UnyuTimeItem
{
	_label = HAN2ZEN(_argv[0],'num') + '分'
	if _argv[0] == unyu_single_min {
		_label = '\f[bold,1]' + _label + '\f[bold,default]'
	}

	"\![*]\__q[%(_argv[1])]%(_label)　　\__q"
}

//---- 時間を選ぶ（始めはしない。「○○分で始める」で始める）
UnyuPick15
{
	UnyuPickMinutes(15)
}

UnyuPick25
{
	UnyuPickMinutes(25)
}

UnyuPick45
{
	UnyuPickMinutes(45)
}

UnyuPick60
{
	UnyuPickMinutes(60)
}

UnyuPickMinutes
{
	unyu_single_min = _argv[0]
	--
	UnyuWorkMenu("ほな、%(HAN2ZEN(_argv[0],'num'))分にしよか。")
}

//------------------------------------------------------------------------------
// 選んである時間で始める
//------------------------------------------------------------------------------
UnyuStartSingle
{
	unyu_mode     = 'single'
	unyu_limitmin = unyu_single_min
	--
	UnyuStartCheck
}

//------------------------------------------------------------------------------
// 作業時間を自分で決める（5〜120 分）
// ID を On で始めると、その名前のイベントが直接発生する
//------------------------------------------------------------------------------
UnyuAskMinutes
{
	unyu_dropscreen = 0

	'\0\s[0]\![set,balloontimeout,0]'
	--
	'何分歩いたらええ？\w9\n数字で教えてな。\w9\n（５〜１２０分）'
	--
	"\![open,inputbox,OnUnyuSetMinutes,0,%(unyu_single_min)]"
	--
	'\e'
}

OnUnyuSetMinutes
{
	//---- ID が On で始まるイベントなので、Reference は一つ前にずれる
	//---- 全角の数字や「分」、空白が付いていても受け付ける
	_text = ZEN2HAN(reference[0])
	_text = REPLACE(_text,'分','')
	_text = REPLACE(_text,' ','')

	if !ISINTSTR(_text) {
		UnyuWorkMenu('数字で頼むわ。')
		return
	}

	_min = TOINT(_text)
	if _min < 5 {
		UnyuWorkMenu('それやと短すぎるわ。\n５分からにしといてな。')
		return
	}
	if _min > 120 {
		UnyuWorkMenu('そんな長いこと歩かれへんわ。\n１２０分までにしといてな。')
		return
	}

	//---- 選ぶだけで、始めない（「○○分で始める」で始める）
	unyu_single_min = _min
	--
	UnyuWorkMenu("%(HAN2ZEN(_min,'num'))分やな。")
}

UnyuCancelMenu
{
	'\0\s[0]ほな、また気が向いたらな。\e'
	'\0\s[0]そうか。\w5無理せんでええで。\e'
}

//------------------------------------------------------------------------------
// 見るファイルが決まっていれば開始、なければ聞く
// 無くなったファイル（移動や削除）は外してから始める。全部無くなっていたら聞き直す
//------------------------------------------------------------------------------
UnyuStartCheck
{
	//---- 1 つも決まっていなければ聞く（決まったらそのまま始める）
	if ARRAYSIZE(UnyuWatchList) <= 0 {
		return UnyuAskPathAdd
	}

	//---- 全部見当たらないときは、見るファイルの画面で直してもらう
	//---- 直した直後に始まってしまわないよう、作業時間は 0 に戻す（OnUnyuSetPath）
	if ARRAYSIZE(UnyuWatchListExisting) <= 0 {
		unyu_limitmin = 0
		return UnyuWatchMenu('見るファイルが、\w5どれも見当たらんわ。\w9\n直してから、\w5もういっぺん始めてな。')
	}

	//---- 見当たらないファイルは今回だけ見ずに始める。一覧には残す
	_missing = UnyuWatchMissingNames
	if ARRAYSIZE(_missing) > 0 {
		'\0\s[0]' + "%(UnyuJoinNames(_missing))は見当たらんから、\w5\n今回は外して始めるで。\w9\n" + UnyuStartSession
	}
	else {
		UnyuStartSession
	}
}

//------------------------------------------------------------------------------
// 見るファイルを尋ねる
//   UnyuAskPathAdd   新しく足す（入力欄は空）
//   UnyuAskPathEdit  _argv[0] 番目を差し替える（入力欄に今のパスを入れておく）
// ID を On で始めると、その名前のイベントが直接発生する
// UnyuAskPathAdd の _argv[0] に台詞を渡すと、問いかけの前に言う
//------------------------------------------------------------------------------
UnyuAskPathAdd
{
	unyu_dropscreen = 0

	unyu_editindex = -1

	'\0\s[0]\![set,balloontimeout,0]'
	--
	if _argc > 0 {
		_argv[0]
	}
	--
	'どのファイルを見とけばええ？\w9\nフルパスで教えてな。'
	--
	'\![open,inputbox,OnUnyuSetPath,0]'
	--
	'\e'
}

UnyuAskPathEdit
{
	_list = UnyuWatchList

	//---- 古い選択肢を押されたときは、何もせずに画面を出し直す
	if _argv[0] >= ARRAYSIZE(_list) {
		return UnyuWatchMenu
	}

	unyu_editindex = _argv[0]
	unyu_dropscreen = 0

	'\0\s[0]\![set,balloontimeout,0]'
	--
	"「%(UnyuWatchFileTalkName(_list[_argv[0]]))」の代わりに、\w5\nどのファイルを見とけばええ？\w9\nフルパスで教えてな。"
	--
	"\![open,inputbox,OnUnyuSetPath,0,%(AYATEMPLATE.EscapeText(_list[_argv[0]]))]"
	--
	'\e'
}

//------------------------------------------------------------------------------
// 入力を受け取る
// うまくいかなかったときは、一言添えて元の画面（見るファイルの画面か、作業準備・ポモドーロの設定）に戻す
// 打ち間違いで前の設定まで失わないよう、差し替えのときは前のファイルがまだあれば残す
// 前のファイルも無くなっていたら外す（見られないファイルを残しておいても使えない）
//------------------------------------------------------------------------------
OnUnyuSetPath
{
	//---- ID が On で始まるイベントなので、Reference は一つ前にずれる
	//---- reference[0] が入力内容（OnUserInput の reference[1] にあたる）
	_path = reference[0]
	_list = UnyuWatchList
	_edit = unyu_editindex
	if _edit >= ARRAYSIZE(_list) {
		_edit = -1
	}

	_keep = ''
	if STRLEN(_path) < 1 || FSIZE(_path) < 0 {
		if _edit >= 0 {
			if FSIZE(_list[_edit]) >= 0 {
				_keep = '\n変更前のファイルのままにしとくで。'
			}
			else {
				_list[_edit] = ''
				UnyuWatchListSet(_list)
				_keep = '\n変更前のファイルも見当たらんから、外しといたで。'
			}
		}
	}

	if STRLEN(_path) < 1 {
		return UnyuBackFromPath('なんも入っとらんかったわ。' + _keep)
	}

	//---- 実在するか確かめる。FSIZE は失敗すると -1 を返す
	if FSIZE(_path) < 0 {
		return UnyuBackFromPath('そのファイル、見つからんかったわ。' + _keep)
	}

	//---- もう見ているファイルなら、足さない（差し替えで同じファイルを入れ直したのは構わない）
	//---- Windows のパスは大文字と小文字を区別しないので、そろえて比べる
	for _i = 0 ; _i < ARRAYSIZE(_list) ; _i++ {
		if _i != _edit && TOLOWER(_list[_i]) == TOLOWER(_path) {
			return UnyuBackFromPath('そのファイルは、もう見とるで。')
		}
	}

	if _edit >= 0 {
		_list[_edit] = _path
	}
	elseif ARRAYSIZE(_list) < UnyuWatchMax {
		_list ,= _path
	}
	else {
		return UnyuBackFromPath("もう%(HAN2ZEN(UnyuWatchMax,'num'))つ見とるから、これ以上は無理やわ。")
	}
	UnyuWatchListSet(_list)

	//---- 時間を選んだ後に聞いたのなら、そのまま始める
	//---- 「見るファイル」の項目から来たのなら、元の画面に戻す
	if unyu_limitmin > 0 {
		UnyuStartSession
	}
	else {
		UnyuBackFromPath('覚えたで。')
	}
}

//---- 見るファイルの入力の後に、元の画面へ戻す
UnyuBackFromPath
{
	if unyu_inwatchmenu {
		UnyuWatchMenu(_argv[0])
	}
	else {
		UnyuBackToSetup(_argv[0])
	}
}

//------------------------------------------------------------------------------
// 入力のキャンセル
// ID が On で始まっていても <ID>Cancel は発生しない。
// 常に OnUserInputCancel が来て、reference[0] に入力ボックスの ID が入る
//------------------------------------------------------------------------------
OnUserInputCancel
{
	//---- 作業中は何もしない（始めるときに開いている入力ボックスを閉じるので、そのキャンセルが来ても
	//---- 作業準備画面を出したり、作業時間を 0 にしたりしない。UnyuCloseInputs）
	if unyu_running {
		return
	}

	//---- 時間の入力をやめたときは、作業準備画面に戻す
	if reference[0] == 'OnUnyuSetMinutes' {
		UnyuWorkMenu('ほな、選び直そか。')
		return
	}

	//---- ポモドーロの設定の入力をやめたときは、設定の画面に戻す
	if SUBSTR(reference[0],0,13) == 'OnUnyuSetPomo' {
		UnyuPomoMenu('ほな、そのままにしとくで。')
		return
	}

	if reference[0] != 'OnUnyuSetPath' {
		return
	}

	//---- 「見るファイル」の項目から来たのなら、元の画面に戻す
	if unyu_limitmin <= 0 {
		UnyuBackFromPath('ほな、そのままにしとくで。')
		return
	}

	//---- 始めようとしてファイルを聞いたところでやめたのなら、ここで終わる
	unyu_limitmin = 0

	'\0\s[0]ええよ、また今度で。\e'
}

//******************************************************************************
// セッション開始
//******************************************************************************

UnyuStartSession
{
	if unyu_mode == 'pomo' {
		UnyuPomoStart
		return
	}

	if unyu_limitmin <= 0 {
		unyu_limitmin = 25
	}

	unyu_mode       = 'single'
	unyu_phase      = 'work'
	UnyuWatchBegin
	unyu_count      = 0
	unyu_starttick  = GETTICKCOUNT
	unyu_lasttick   = GETTICKCOUNT
	unyu_saidsave   = 0
	unyu_running    = 1
	unyu_nextnotice = UnyuNoticeStep

	"%(UnyuCloseInputs)\0\s[1]%(UnyuSound('start'))ほな、%(HAN2ZEN(unyu_limitmin,'num'))分な。\w9\n%(username)も頑張りや。/
	%(UnyuFileWatchStart)\e"
}

//------------------------------------------------------------------------------
// 今回見るファイルを決めて、ファイルごとの変数を用意する（開始時に 1 回）
// 途中で設定を変えられても困らないよう、保存してある一覧を写して使う
//------------------------------------------------------------------------------
UnyuWatchBegin
{
	unyu_watchfiles = UnyuWatchListExisting
	unyu_filealive  = IARRAY
	unyu_filecounts = IARRAY
	unyu_filegone   = IARRAY
	for _i = 0 ; _i < ARRAYSIZE(unyu_watchfiles) ; _i++ {
		unyu_filealive  ,= 1
		unyu_filecounts ,= 0
		unyu_filegone   ,= 0
	}
	unyu_basesize = UnyuWatchSizes
}

//------------------------------------------------------------------------------
// 今のファイルサイズを、ファイルごとの配列で返す。取れなければ -1
//------------------------------------------------------------------------------
UnyuWatchSizes
{
	_sizes = IARRAY
	foreach unyu_watchfiles ; _path {
		_sizes ,= FSIZE(_path)
	}
	_sizes
}

//------------------------------------------------------------------------------
// ファイルサイズの変化の合計（バイト）。_argv に基準のサイズの配列を渡す
// 見えなくなったファイルと、サイズが取れないファイルは数えない
//------------------------------------------------------------------------------
UnyuWatchDiff
{
	_diff = 0
	for _i = 0 ; _i < ARRAYSIZE(unyu_watchfiles) ; _i++ {
		if _i < _argc && unyu_filealive[_i] {
			_now = FSIZE(unyu_watchfiles[_i])
			if _now >= 0 && _argv[_i] >= 0 {
				_diff += _now - _argv[_i]
			}
		}
	}
	_diff
}

//------------------------------------------------------------------------------
// 開いている入力ボックスを全部閉じるタグ（作業を始めるときに付ける）
// 呼び名や時間の入力ボックスを開いたまま始めると、作業中に入力されてしまう
// （呼び名は OnInputUserName が作業中は受け付けないので、黙って捨てられることになる）
// 閉じたときに OnUserInputCancel が来ても、作業中は何もしない
//------------------------------------------------------------------------------
UnyuCloseInputs
{
	'\![close,inputbox,__SYSTEM_ALL_INPUT__]'
}

//------------------------------------------------------------------------------
// ファイル監視を始める・やめるタグ（見ているファイルすべて）
//------------------------------------------------------------------------------
UnyuFileWatchStart
{
	_tags = ''
	foreach unyu_watchfiles ; _path {
		_tags += "\![execute,filewatch,%(AYATEMPLATE.EscapeText(_path)),--async=OnUnyuFileChange]"
	}
	_tags
}

UnyuFileWatchCancel
{
	_tags = ''
	for _i = 0 ; _i < ARRAYSIZE(unyu_watchfiles) ; _i++ {
		if unyu_filealive[_i] {
			_tags += "\![cancel,filewatch,%(AYATEMPLATE.EscapeText(unyu_watchfiles[_i]))]"
		}
	}
	_tags
}

//------------------------------------------------------------------------------
// いちばん動いた（更新回数が多い）ファイルのひとこと。終わりの報告に添える
// 見ているファイルが 1 つだけのとき、どれも動いていないときは空
//------------------------------------------------------------------------------
UnyuMostTouchedTalk
{
	if ARRAYSIZE(unyu_watchfiles) < 2 {
		return ''
	}

	_best  = -1
	_count = 0
	for _i = 0 ; _i < ARRAYSIZE(unyu_watchfiles) ; _i++ {
		if unyu_filecounts[_i] > _count {
			_best  = _i
			_count = unyu_filecounts[_i]
		}
	}

	if _best < 0 {
		return ''
	}

	"いちばんさわっとったんは、\w5「%(UnyuWatchFileTalkName(unyu_watchfiles[_best]))」やな。\w9\n"
}

//------------------------------------------------------------------------------
// 中間報告の間隔（分）。作業時間に応じて変える
//------------------------------------------------------------------------------
UnyuNoticeStep
{
	if unyu_limitmin >= 60 {
		15
	}
	elseif unyu_limitmin >= 25 {
		10
	}
	else {
		5
	}
}

//******************************************************************************
// ファイルが変わった（走行中は静かに数えるだけ。ここでは喋らない）
//
// reference[0] --async で指定した文字列
// reference[1] 指定したパス
// reference[2] 変化の種類 modified / created / deleted
// reference[3] フルパス
//******************************************************************************

OnUnyuFileChange
{
	if !unyu_running {
		return
	}

	//---- どのファイルかは reference[1]（監視を始めたときのパスそのもの）で分かる
	_i = ASEARCH(reference[1],unyu_watchfiles)

	//---- 消された（名前を変えられた）。ファイルを消しても Failure は来ず、ここに deleted が来る
	//---- 保存のときに消してから作り直すエディタもあるので、すぐには外さない
	//---- 時刻を覚えておき、しばらくしても戻らなければ UnyuTick（UnyuWatchCheckGone）が外す
	if reference[2] == 'deleted' {
		if _i >= 0 && unyu_filegone[_i] == 0 {
			unyu_filegone[_i] = GETTICKCOUNT
		}
		return
	}

	if reference[2] != 'modified' && reference[2] != 'created' {
		return
	}

	//---- 消えたと思ったファイルが戻ってきた（消してから作り直す保存）
	if _i >= 0 {
		unyu_filegone[_i] = 0
	}

	if unyu_phase == 'work' {
		unyu_count      = unyu_count + 1
		unyu_cyclecount = unyu_cyclecount + 1
		unyu_lasttick   = GETTICKCOUNT

		if _i >= 0 {
			unyu_filecounts[_i] += 1
		}

		//---- 保存されたので、また心配できるように戻す
		unyu_saidsave = 0
	}
	elseif unyu_phase == 'break' {
		//---- 休憩中の保存は数えない。軽くつっこむのは UnyuTick に任せる
		//---- （ここで喋ると、選択肢を出している最中に割り込むことがある）
		if unyu_breaksave == 0 {
			unyu_breaksave = 1
		}
	}

	//---- ここでは喋らない
	''
}

OnUnyuFileChangeFailure
{
	//---- 監視が続けられなくなった（置き場所のフォルダが無くなった、など）。SSP 側で監視は解除されている
	//---- reference[1] は監視を始めたときのパスそのもの。そのファイルだけを外す
	if !unyu_running {
		return
	}

	_i = ASEARCH(reference[1],unyu_watchfiles)
	if _i < 0 {
		//---- どのファイルか分からないときは、念のため全部止める
		for _j = 0 ; _j < ARRAYSIZE(unyu_watchfiles) ; _j++ {
			unyu_filealive[_j] = 0
		}
		return UnyuWatchStopTalk(reference[2])
	}

	UnyuWatchLost(_i,reference[2])
}

//------------------------------------------------------------------------------
// 消されたまま戻ってこないファイルを外す（UnyuTick から、喋れるときに毎秒）
// deleted が来てから 3 秒たっても無ければ、消された（名前を変えられた）とみなす
// 一度に 1 つだけ扱う。外したときはその台詞を、何もなければ空を返す
//------------------------------------------------------------------------------
UnyuWatchCheckGone
{
	for _i = 0 ; _i < ARRAYSIZE(unyu_watchfiles) ; _i++ {
		if unyu_filealive[_i] && unyu_filegone[_i] > 0 && GETTICKCOUNT - unyu_filegone[_i] >= 3000 {
			if FSIZE(unyu_watchfiles[_i]) >= 0 {
				//---- 通知は来なかったが、戻ってきている
				unyu_filegone[_i] = 0
			}
			else {
				return UnyuWatchLost(_i,'notfound')
			}
		}
	}
	''
}

//------------------------------------------------------------------------------
// _argv[0] 番目のファイルが見られなくなった。_argv[1] は理由（Failure の reference[2] と同じ）
// まだ見られるファイルが残っていれば、そのファイルだけ外して続ける。全部だめなら止める
//------------------------------------------------------------------------------
UnyuWatchLost
{
	_i = _argv[0]

	unyu_filealive[_i] = 0
	unyu_filegone[_i]  = 0

	//---- 消されただけなら SSP はまだ監視を続けているので、ここで解除する（無ければ無視される）
	_cancel = "\![cancel,filewatch,%(AYATEMPLATE.EscapeText(unyu_watchfiles[_i]))]"

	_alive = 0
	foreach unyu_filealive ; _a {
		_alive += _a
	}
	if _alive > 0 {
		return _cancel + DefaultSurface + "「%(UnyuWatchFileTalkName(unyu_watchfiles[_i]))」が見当たらんようになったから、\w5\nそれは外すで。\w9\n他のは、\w5このまま見とくわ。\e"
	}

	_cancel + UnyuWatchStopTalk(_argv[1])
}

//------------------------------------------------------------------------------
// 見られるファイルが無くなったので止める。_argv[0] は理由
//------------------------------------------------------------------------------
UnyuWatchStopTalk
{
	_reason = _argv[0]

	unyu_running = 0
	unyu_phase   = ''

	if _reason == 'notfound' {
		if ARRAYSIZE(unyu_watchfiles) > 1 {
			'\0\s[0]あかん、見とったファイルが全部見当たらんようになったわ。\w9\n一旦止めるで。\e'
		}
		else {
			'\0\s[0]あかん、ファイルが見当たらんようになったわ。\w9\n一旦止めるで。\e'
		}
	}
	elseif _reason == 'notauthorized' {
		'\0\s[0]すまん、外から呼ばれた分は見張れん決まりでな。\w9\nワイをつついて始めてな。\e'
	}
	elseif _reason == 'limit' {
		'\0\s[0]見張れる数が上限に達しとるみたいや。\w9\n他のを止めてから、もういっぺん頼むわ。\e'
	}
	else {
		"\0\s[0]監視がうまいこといかんかったわ。\w9\n（%(AYATEMPLATE.EscapeText(_reason))）\e"
	}
}

//******************************************************************************
// 時間の見張り（1 秒ごと）
//******************************************************************************

UnyuTick
{
	if !unyu_running {
		return
	}

	_elapsedmin = UnyuElapsedMin

	//---- reference[3] はトークを再生できるときに 1、できないときは 0（UKADOC）
	//---- 再生できないときに返したスクリプトは無視されるので、何もせずに返る
	if reference[3] != '1' {
		return
	}

	//---- 消されたまま戻ってこないファイルがあれば、先にそれを言う（作業中も休憩中も）
	_lost = UnyuWatchCheckGone
	if STRLEN(_lost) > 0 {
		return _lost
	}
	if !unyu_running {
		return
	}

	if unyu_mode == 'pomo' {
		UnyuPomoTick
		return
	}

	//---- 時間が来たら締める
	if _elapsedmin >= unyu_limitmin {
		UnyuFinish
		return
	}

	//---- 区切りの中間報告
	if _elapsedmin >= unyu_nextnotice {
		unyu_nextnotice = _elapsedmin + UnyuNoticeStep
		UnyuNoticeTalk(_elapsedmin)
		return
	}

	//---- 保存忘れの心配。一度言ったら、次に保存されるまで黙る
	//---- 一度も保存していないときは「保存忘れ」ではないので言わない
	if unyu_count > 0 && !unyu_saidsave && UnyuSilentMin >= UnyuSilentLimit {
		unyu_saidsave = 1
		UnyuSaveReminderTalk(UnyuSilentMin)
	}
}

//------------------------------------------------------------------------------
// 経過した分数
//------------------------------------------------------------------------------
UnyuElapsedMin
{
	(GETTICKCOUNT - unyu_starttick) / 60000
}

//------------------------------------------------------------------------------
// 最後にファイルが変わってからの分数
//------------------------------------------------------------------------------
UnyuSilentMin
{
	(GETTICKCOUNT - unyu_lasttick) / 60000
}

//------------------------------------------------------------------------------
// 保存忘れの心配
//------------------------------------------------------------------------------
UnyuSaveReminderTalk
{
	_silent = _argv[0]

	"\0\s[1]最後の保存から%(HAN2ZEN(_silent,'num'))分経っとるで。\w9\n保存、\w5忘れてへんか？\e"
	"\0\s[1]%(HAN2ZEN(_silent,'num'))分ほど、\w5ファイルが動いとらんな。\w9\n保存だけしとき。\w9\n消えてまうと悲しいで。\e"
	"\0\s[1]ちょっと手ぇ止まっとるな。\w9\n休憩ならええんやけど、\w5保存はしたか？\e"
}

//------------------------------------------------------------------------------
// 保存忘れを心配しはじめるまでの分数。作業時間に応じて変える
//------------------------------------------------------------------------------
UnyuSilentLimit
{
	if unyu_limitmin >= 60 {
		20
	}
	elseif unyu_limitmin >= 25 {
		12
	}
	else {
		8
	}
}

//------------------------------------------------------------------------------
// 中間報告
//------------------------------------------------------------------------------
UnyuNoticeTalk
{
	_min    = _argv[0]
	_rest   = unyu_limitmin - _min
	_diff   = UnyuDiffByte
	_silent = UnyuSilentMin

	if unyu_count <= 0 {
		"\0\s[1]%(HAN2ZEN(_min,'num'))分経ったで。\w9\n悩んどるんか？\w9\n残り%(HAN2ZEN(_rest,'num'))分、ぼちぼちいこか。\e"
		"\0\s[1]%(HAN2ZEN(_min,'num'))分経ったで。\w9\n考えがまとまらんときもあるわな。\w9\n残り%(HAN2ZEN(_rest,'num'))分、ゆっくりいこ。\e"
	}
	elseif !unyu_saidsave && _silent >= UnyuSilentLimit {
		//---- 中間報告のタイミングで無音なら、ここでも心配する
		//---- すでに言った後なら繰り返さず、下の普通の報告に落とす
		unyu_saidsave = 1
		--
		UnyuSaveReminderTalk(_silent)
	}
	elseif _diff > 0 {
		"\0\s[1]%(HAN2ZEN(_min,'num'))分で更新%(HAN2ZEN(unyu_count,'num'))回、\w5%(UnyuSizeText(_diff))増えとるで。\w9\n残り%(HAN2ZEN(_rest,'num'))分や。\e"
	}
	elseif _diff < 0 {
		"\0\s[1]%(HAN2ZEN(_min,'num'))分で更新%(HAN2ZEN(unyu_count,'num'))回、\w5%(UnyuSizeText(_diff))減っとるで。\w9\n残り%(HAN2ZEN(_rest,'num'))分や。\e"
	}
	else {
		"\0\s[1]%(HAN2ZEN(_min,'num'))分で%(HAN2ZEN(unyu_count,'num'))回の更新やな。\w9\n残り%(HAN2ZEN(_rest,'num'))分、その調子や。\e"
	}
}

//------------------------------------------------------------------------------
// 開始時からのファイルサイズの変化（バイト。見ているファイルの合計）
//------------------------------------------------------------------------------
UnyuDiffByte
{
	UnyuWatchDiff(unyu_basesize)
}

//------------------------------------------------------------------------------
// バイト数を読みやすい文字列にする（符号は落とし、絶対値だけを返す）
//   1MB 以上  → 「1.2MB」
//   1KB 以上  → 「340KB」
//   それ未満  → 「512バイト」
//------------------------------------------------------------------------------
UnyuSizeText
{
	_byte = _argv[0]

	if _byte < 0 {
		_byte = 0 - _byte
	}

	if _byte >= 1048576 {
		//---- 小数第 1 位まで出す。YAYA の整数割り算で桁を作る
		_whole = _byte / 1048576
		_frac  = ((_byte % 1048576) * 10) / 1048576

		if _frac > 0 {
			return "%(_whole).%(_frac)MB"
		}

		return "%(_whole)MB"
	}

	if _byte >= 1024 {
		return "%(_byte / 1024)KB"
	}

	"%(_byte)バイト"
}

//******************************************************************************
// セッション終了
//******************************************************************************

UnyuFinish
{
	_min   = UnyuElapsedMin
	_count = unyu_count
	_diff  = UnyuDiffByte

	if _min <= 0 {
		_min = unyu_limitmin
	}

	unyu_running = 0

	UnyuFileWatchCancel
	--
	'\0\s[0]'
	--
	UnyuSound('end')
	--
	UnyuFinishNotice
	--
	UnyuReportTalk(_min,_count,_diff,UnyuMostTouchedTalk)
}

//------------------------------------------------------------------------------
// 時間が来たことのお知らせ（終わりの報告の頭に付ける）
// 分数は報告のほうで言うので、ここでは言わない
//------------------------------------------------------------------------------
UnyuFinishNotice : nonoverlap
{
	'作業時間、\w5終わりやで。\w9\n'
	'はい、\w5時間や。\w9\n'
	'設定時間、ここまでやで。\w9ワイも休憩するわ。\w9\n'
}

//------------------------------------------------------------------------------
// 終わりの報告
// _argv[0] 分、_argv[1] 更新回数、_argv[2] サイズの変化（バイト）、すべて見ているファイルの合計
// _argv[3] いちばん動いたファイルのひとこと（UnyuMostTouchedTalk。無ければ空）。数字の後に挟む
//------------------------------------------------------------------------------
UnyuReportTalk
{
	_min   = _argv[0]
	_count = _argv[1]
	_diff  = _argv[2]
	_size  = UnyuSizeText(_diff)
	_most  = ''
	if _argc > 3 {
		_most = _argv[3]
	}

	if _count <= 0 {
		"この%(HAN2ZEN(_min,'num'))分、\w5更新はなしやったな。\w9\n考えとった時間かもしれんし、\w5それはそれでええ。\w9\nまたやろか？\e"
		"%(HAN2ZEN(_min,'num'))分、\w5ファイルは動かんかったわ。\w9\n手が止まる日もあるわな。\w9\nお疲れさん。\e"
		return
	}

	if _diff > 0 {
		"この%(HAN2ZEN(_min,'num'))分で監視対象ファイルの更新が%(HAN2ZEN(_count,'num'))回あったで。\w9\nファイルサイズは%(_size)変化しとったな。\w9\n%(_most)進捗はどうや？\e"
		"%(HAN2ZEN(_min,'num'))分で%(HAN2ZEN(_count,'num'))回の更新、\w5%(_size)増えたで。\w9\n%(_most)ようやったな、%(username)。\w9\nちょっと休んどき。\e"
	}
	elseif _diff < 0 {
		"更新%(HAN2ZEN(_count,'num'))回で、\w5%(_size)減っとるな。\w9\n%(_most)削るんも進捗やで。\w9\nようやった。\e"
		"この%(HAN2ZEN(_min,'num'))分、\w5%(HAN2ZEN(_count,'num'))回さわって%(_size)減ったわ。\w9\n%(_most)刈り込んだんやな。\w9\nお疲れさん。\e"
	}
	else {
		"%(HAN2ZEN(_min,'num'))分で%(HAN2ZEN(_count,'num'))回の更新やな。\w9\nサイズはほぼ変わらずや。\w9\n%(_most)直しとったんか？\w9\nお疲れさん。\e"
		"更新は%(HAN2ZEN(_count,'num'))回、\w5サイズは据え置きやな。\w9\n%(_most)手を入れとったんやろ。\w9\nええ時間やったな。\e"
	}
}

//------------------------------------------------------------------------------
// 作業中のダブルクリック：今の様子を伝えて、続けるか辞めるかを聞く
//------------------------------------------------------------------------------
UnyuProgressReport
{
	_min   = UnyuElapsedMin
	_count = unyu_count
	_diff  = UnyuDiffByte

	//---- ポモドーロでは、今の 1 回ぶんの様子を伝える
	if unyu_mode == 'pomo' {
		_min   = UnyuPhaseMin
		_count = unyu_cyclecount
		_diff  = UnyuCycleDiffByte
	}
	_rest = unyu_limitmin - _min

	if _rest < 0 {
		_rest = 0
	}

	'\0\s[1]'
	--
	if unyu_mode == 'pomo' {
		"%(HAN2ZEN(unyu_cycle,'num'))回目の途中や。\w9\n"
	}
	--
	if _count <= 0 {
		"今んとこ%(HAN2ZEN(_min,'num'))分、\w5更新はまだやな。\w9\n残り%(HAN2ZEN(_rest,'num'))分やで。"
	}
	elseif _diff > 0 {
		"今んとこ%(HAN2ZEN(_min,'num'))分で更新%(HAN2ZEN(_count,'num'))回、\w5%(UnyuSizeText(_diff))増えとる。\w9\n残り%(HAN2ZEN(_rest,'num'))分やで。"
	}
	elseif _diff < 0 {
		"今んとこ%(HAN2ZEN(_min,'num'))分で更新%(HAN2ZEN(_count,'num'))回、\w5%(UnyuSizeText(_diff))減っとる。\w9\n残り%(HAN2ZEN(_rest,'num'))分やで。"
	}
	else {
		"今んとこ%(HAN2ZEN(_min,'num'))分で%(HAN2ZEN(_count,'num'))回の更新や。\w9\n残り%(HAN2ZEN(_rest,'num'))分やで。"
	}
	--
	AYATEMPLATE.MenuItem("まだ続ける","UnyuResume",200)
	--
	AYATEMPLATE.MenuItem("ここで辞める","UnyuAbort")
	--
	AYATEMPLATE.MenuItem("しゃべり頻度を変えて","Menu_TALKINTERVAL",150)
}

//------------------------------------------------------------------------------
// 続ける（監視はそのまま。何もせず戻る）
//------------------------------------------------------------------------------
UnyuResume
{
	'\0\s[1]ほな、続けよか。\w9\nワイも歩いとくで。\e'
	'\0\s[1]了解や。\w9\nまだ歩けるで。\e'
	'\0\s[1]ほな、もうちょいやな。\e'
}

//------------------------------------------------------------------------------
// 途中で辞める
//------------------------------------------------------------------------------
UnyuAbort
{
	if unyu_mode == 'pomo' {
		UnyuPomoQuit
		return
	}

	_min   = UnyuElapsedMin
	_count = unyu_count

	unyu_running = 0

	UnyuFileWatchCancel
	--
	'\0\s[0]'
	--
	if _count <= 0 {
		"%(HAN2ZEN(_min,'num'))分で切り上げやな。\w9\n更新はなしやったで。\w9\nまた気が向いたら呼んでな。\e"
	}
	else {
		"%(HAN2ZEN(_min,'num'))分で切り上げか。\w9\n更新は%(HAN2ZEN(_count,'num'))回あったで。\w9\nようやった、お疲れさん。\e"
	}
}

//******************************************************************************
// 作業中のランダムトーク（作業用の台詞に差し替える）
//******************************************************************************

UnyuWorkTalk : nonoverlap
{
	'\0\s[1]'
	--
	"%(username)、\w5調子どうや？\w9\nワイはこの通り、\w5歩いとるで。"
	'カラカラ…\w5…\w5。\w9\nええ音やろ。'
	'手ぇ止まっとらんか？\w9\nワイはまだ歩けるで。'
	'根詰めすぎんようにな。\w9\n肩、回しとき。'
	'ワイが止まるまでが勝負や。'
	'ちょっとずつでええんよ。\w9\n進んどったらそれで。'
	'見とるだけやけどな。\w9\nまあ、おらんよりはマシやろ。'
	'水でも飲んどき。\w9\nワイは歩いとくから。'
	'急がんでええで。\w9\n一歩ずつや。'
	'ファイルの保存、\w5忘れんときや。'
	'ワイが画面の邪魔やったら、\w5縮小表示してや。\w9\n喋る時だけ手前に出てくる設定も、\w5ええかもな。'
	//---- 歩きながら
	'この回し車、\w5どこにも辿り着かへんのよな。\w9\nまあ、\w5そこがええんやけど。'
	"ワイが止まらん限り、\w5%(username)も止まらんやろ。\w9\nもちろん、\w5途中で休憩してもええ。"
	'足音、\w5うるさないか。\w9\nうるさかったら言うてな。'
	'歩いとるとな、\w5余計なこと考えんで済むわ。'
	'ワイの歩幅、\w5ちいさいねん。\w9\nその分、\w5長いこと歩けるけどな。'
	//---- 作業を見ている
	//---- 更新回数やサイズに触れる台詞はここに書かない。
	//---- この関数は状態を見ずに選ばれるので、事実と食い違うことがある。
	//---- 数字に基づく話は UnyuNoticeTalk（中間報告）と UnyuReportTalk（終了報告）が受け持つ。
	'見守っとるだけやけど、\w5ちゃんと見とるからな。'
	'勢いが乗っとるときは、\w5そのまま行き。\w9\n止まったら止まったでええし。'
	'詰まったら、\w5いっぺん離れてみ。\w9\n戻ってきたら見えることもあるわ。'
	'完璧やのうてええねん。\w9\nとりあえずでも、\w5進めてみ。'
	//---- 休むことについて
	'ときどき、\w5遠くも見とき。\w9\n近くばっかり見とったら疲れるで。'
	'背中、\w5丸まっとらんか。\w9\nワイが言えた義理やないけど。'
	'疲れたら、\w5止めてええんやで。\w9\nワイをつついたら終われるからな。'
	'息、\w5吸うとるか。\w9\n集中しとると止まるらしいで。'
	//---- ぼんやりしたこと
	'…\w5…\w5。\w9\n何言おうとしとったか、\w5忘れてもうた。'
	'カラカラ…\w5…\w5カラカラ…\w5…'
	'時計見るより、\w5ワイ見とったほうが早いで。\w9\n…\w5…\w5嘘やけど。'
	--
	'\e'
}

//******************************************************************************
// ポモドーロ
//
// 作業 → 休憩 → （確認） → 作業 → … を、ユーザーが終わると言うまで繰り返す。
// unyu_pomo_sets 回ごとに、休憩が長くなる。
// 休憩が明けたら勝手に歩き出さず、選択肢で確かめる（席を外しているかもしれないので）。
// 選択肢が消えても、ダブルクリック（UnyuRunningMenu）で同じ場面に戻れる。
// ゴーストを終了すると、変数ごとセッションは消える。
//******************************************************************************

//------------------------------------------------------------------------------
// 設定の表（_argv[0] は 'work' / 'break' / 'long' / 'sets'）
//------------------------------------------------------------------------------

//---- 定番の値。最初の設定と、空っぽで入力されたときに使う
UnyuPomoDefault
{
	case _argv[0] {
		when 'work'  { 25 }
		when 'break' { 5 }
		when 'long'  { 15 }
		others       { 4 }
	}
}

//---- 受け付ける範囲
UnyuPomoLow
{
	case _argv[0] {
		when 'work'  { 5 }
		when 'sets'  { 2 }
		others       { 1 }
	}
}

UnyuPomoHigh
{
	case _argv[0] {
		when 'work'  { 120 }
		when 'break' { 30 }
		when 'long'  { 60 }
		others       { 10 }
	}
}

UnyuPomoUnit
{
	if _argv[0] == 'sets' {
		'回'
	}
	else {
		'分'
	}
}

UnyuPomoLabel
{
	case _argv[0] {
		when 'work'  { '作業の時間' }
		when 'break' { '休憩の時間' }
		when 'long'  { '長い休憩' }
		others       { '長い休憩までの回数' }
	}
}

UnyuPomoValue
{
	case _argv[0] {
		when 'work'  { unyu_pomo_work }
		when 'break' { unyu_pomo_break }
		when 'long'  { unyu_pomo_long }
		others       { unyu_pomo_sets }
	}
}

//------------------------------------------------------------------------------
// 設定の画面（作業準備画面の「ポモドーロでいく」から）
// _argv[0] に台詞を渡すと、最初の一言の代わりにそれを言う（末尾に \n を付けない）
// 設定の値は選択肢そのものに出し、選ぶとその値を変えられる
//   作業 / 休憩           （1 行目、2 列）
//   長い休憩 / 回数       （2 行目、2 列。回数は長いので右端に置き、幅をそろえない）
//   音                    （3 行目。選ぶたびに切り替わる）
//   見るファイル          （4 行目）
//------------------------------------------------------------------------------
UnyuPomoMenu
{
	//---- まだ始めていない。unyu_mode は入力の後に戻る画面の目印（UnyuBackToSetup）
	//---- unyu_limitmin を 0 にしておかないと、ファイルを決めた直後に始まってしまう（OnUnyuSetPath）
	unyu_limitmin    = 0
	unyu_mode        = 'pomo'
	unyu_inwatchmenu = 0
	unyu_dropscreen  = 1

	'\0\s[0]\![quicksection,1]'
	--
	if _argc > 0 {
		_argv[0]
	}
	else {
		'ポモドーロやな。'
	}
	--
	UnyuShortMenuItem("この設定で始める","UnyuPomoGo",150)
	--
	UnyuShortMenuItem("普通の設定に戻す","UnyuPomoBack",0)
	--
	UnyuShortMenuItem("作業: %(HAN2ZEN(unyu_pomo_work,'num'))分","UnyuPomoAskWork",150)
	--
	UnyuShortMenuItem("休憩: %(HAN2ZEN(unyu_pomo_break,'num'))分","UnyuPomoAskBreak",0)
	--
	UnyuShortMenuItem("長い休憩: %(HAN2ZEN(unyu_pomo_long,'num'))分","UnyuPomoAskLong",100)
	--
	UnyuShortMenuItem("長い休憩までの作業: %(HAN2ZEN(unyu_pomo_sets,'num'))回","UnyuPomoAskSets",0,0)
	--
	UnyuSoundSetupItem(100)
	--
	UnyuWatchFileSetupItem
	--
	AYATEMPLATE.MenuItem("やっぱやめとく","UnyuCancelMenu",150)
	--
	'\![quicksection,0]\e'
}

//------------------------------------------------------------------------------
// 作業準備画面に戻る（「ほな、始めよか。」だと、もう始めかけていたので合わない）
//------------------------------------------------------------------------------
UnyuPomoBack
{
	UnyuWorkMenu(UnyuPomoBackTalk)
}

UnyuPomoBackTalk : nonoverlap
{
	'ほな、ふつうに歩こか。'
	'ポモドーロは、また今度やな。'
}

UnyuPomoGo
{
	unyu_mode     = 'pomo'
	unyu_limitmin = unyu_pomo_work
	--
	UnyuStartCheck
}

//------------------------------------------------------------------------------
// 設定の入力
// ID を On で始めると、その名前のイベントが直接発生する（Reference は一つ前にずれる）
//------------------------------------------------------------------------------
UnyuPomoAskWork
{
	UnyuPomoAskValue('work','OnUnyuSetPomoWork')
}

UnyuPomoAskBreak
{
	UnyuPomoAskValue('break','OnUnyuSetPomoBreak')
}

UnyuPomoAskLong
{
	UnyuPomoAskValue('long','OnUnyuSetPomoLong')
}

UnyuPomoAskSets
{
	UnyuPomoAskValue('sets','OnUnyuSetPomoSets')
}

//---- _argv[0] は設定の名前、_argv[1] は入力ボックスの ID
UnyuPomoAskValue
{
	unyu_dropscreen = 0

	_key  = _argv[0]
	_unit = UnyuPomoUnit(_key)

	'\0\s[0]\![set,balloontimeout,0]'
	--
	"%(UnyuPomoLabel(_key))は、\w5どうする？\w9\n数字で教えてな。\w9\n/
	（%(HAN2ZEN(UnyuPomoLow(_key),'num'))〜%(HAN2ZEN(UnyuPomoHigh(_key),'num'))%(_unit)。\w5/
	空っぽなら%(HAN2ZEN(UnyuPomoDefault(_key),'num'))%(_unit)）"
	--
	"\![open,inputbox,%(_argv[1]),0,%(UnyuPomoValue(_key))]"
	--
	'\e'
}

OnUnyuSetPomoWork
{
	UnyuPomoSetValue('work',reference[0])
}

OnUnyuSetPomoBreak
{
	UnyuPomoSetValue('break',reference[0])
}

OnUnyuSetPomoLong
{
	UnyuPomoSetValue('long',reference[0])
}

OnUnyuSetPomoSets
{
	UnyuPomoSetValue('sets',reference[0])
}

//------------------------------------------------------------------------------
// 入力を受け取って、設定の画面に戻す
//   空っぽ          → 定番の値にする
//   数字でない      → 変えない
//   範囲の外        → 変えない（範囲を伝える）
// 全角の数字や「分」「回」、空白が付いていても受け付ける
//------------------------------------------------------------------------------
UnyuPomoSetValue
{
	_key   = _argv[0]
	_unit  = UnyuPomoUnit(_key)
	_label = UnyuPomoLabel(_key)
	_low   = UnyuPomoLow(_key)
	_high  = UnyuPomoHigh(_key)

	_text = ZEN2HAN(_argv[1])
	_text = REPLACE(_text,_unit,'')
	_text = REPLACE(_text,' ','')
	_text = REPLACE(_text,'　','')

	//---- ローカル変数は { } の中で作るとその外で消えるので、先に作っておく
	_value = 0
	_talk  = ''

	if STRLEN(_text) == 0 {
		_value = UnyuPomoDefault(_key)
		_talk  = "空っぽやったから、定番の%(HAN2ZEN(_value,'num'))%(_unit)にしといたで。"
	}
	elseif !ISINTSTR(_text) {
		return UnyuPomoMenu('数字で頼むわ。')
	}
	else {
		_value = TOINT(_text)
		if _value < _low || _value > _high {
			return UnyuPomoMenu("それはちょっと無理やな。\w9\n%(_label)は、\w5%(HAN2ZEN(_low,'num'))〜%(HAN2ZEN(_high,'num'))%(_unit)にしといてな。")
		}
		_talk = "%(_label)を%(HAN2ZEN(_value,'num'))%(_unit)にしたで。"
	}

	LETTONAME('unyu_pomo_' + _key,_value)
	--
	UnyuPomoMenu(_talk)
}

//------------------------------------------------------------------------------
// 始める（UnyuStartSession から。監視するファイルは決まっている）
//------------------------------------------------------------------------------
UnyuPomoStart
{
	unyu_running   = 1
	unyu_mode      = 'pomo'
	unyu_limitmin  = unyu_pomo_work
	UnyuWatchBegin
	unyu_count     = 0
	unyu_starttick = GETTICKCOUNT
	unyu_cycle     = 1
	unyu_worktotal = 0
	--
	UnyuCloseInputs
	--
	UnyuPomoBeginWork("ほな、\w5ポモドーロでいこか。\w9\n%(HAN2ZEN(unyu_limitmin,'num'))分歩いたら、\w5休憩や。\w9\n%(username)も頑張りや。")
	--
	UnyuFileWatchStart
	--
	'\e'
}

//------------------------------------------------------------------------------
// 次の作業に入る（休憩明けの「次いこか」、休憩中の「休憩を切り上げる」から）
//------------------------------------------------------------------------------
UnyuPomoNext
{
	//---- 古い選択肢を押されたときは、何もしない
	if !unyu_running || unyu_phase == 'work' {
		return ''
	}

	unyu_cycle += 1
	--
	UnyuPomoBeginWork(UnyuPomoNextTalk)
	--
	'\e'
}

UnyuPomoNextTalk : nonoverlap
{
	"ほな、\w5%(HAN2ZEN(unyu_cycle,'num'))回目いこか。\w9\n%(HAN2ZEN(unyu_limitmin,'num'))分な。"
	"よっしゃ、\w5%(HAN2ZEN(unyu_cycle,'num'))回目や。\w9\nまた歩くで。"
	"%(HAN2ZEN(unyu_cycle,'num'))回目、\w5始めよか。\w9\nぼちぼちいこ。"
}

//------------------------------------------------------------------------------
// 作業を始める。変数を整えて、歩き出しのスクリプトを返す
// _argv[0] は歩き出すときの台詞
//------------------------------------------------------------------------------
UnyuPomoBeginWork
{
	unyu_phase      = 'work'
	unyu_phasetick  = GETTICKCOUNT
	unyu_lasttick   = GETTICKCOUNT
	unyu_saidsave   = 0
	unyu_cyclecount = 0
	unyu_cyclebase  = UnyuWatchSizes

	'\0\s[1]' + UnyuSound('start') + _argv[0]
}

//------------------------------------------------------------------------------
// 今の作業または休憩に入ってからの分数
//------------------------------------------------------------------------------
UnyuPhaseMin
{
	(GETTICKCOUNT - unyu_phasetick) / 60000
}

//------------------------------------------------------------------------------
// 今の作業でのファイルサイズの変化（バイト。見ているファイルの合計）
//------------------------------------------------------------------------------
UnyuCycleDiffByte
{
	UnyuWatchDiff(unyu_cyclebase)
}

//------------------------------------------------------------------------------
// 時間の見張り（UnyuTick から。喋れるときだけ呼ばれる）
//------------------------------------------------------------------------------
UnyuPomoTick
{
	_min = UnyuPhaseMin

	if unyu_phase == 'work' {
		if _min >= unyu_limitmin {
			UnyuPomoWorkEnd
			return
		}

		//---- 保存忘れの心配。1 回だけのときと同じ。今の作業で一度も保存していなければ言わない
		if unyu_cyclecount > 0 && !unyu_saidsave && UnyuSilentMin >= UnyuSilentLimit {
			unyu_saidsave = 1
			UnyuSaveReminderTalk(UnyuSilentMin)
		}
	}
	elseif unyu_phase == 'break' {
		if _min >= unyu_breakmin {
			unyu_phase = 'wait'
			UnyuPomoNextAsk(UnyuBreakEndNotice)
			return
		}

		//---- 休憩中に保存されていたら、一度だけ軽くつっこむ
		if unyu_breaksave == 1 {
			unyu_breaksave = 2
			UnyuBreakSaveTalk
		}
	}
	//---- 'wait' は返事を待っているだけ
}

//------------------------------------------------------------------------------
// 1 回ぶんの作業が終わった。休憩に入る
//------------------------------------------------------------------------------
UnyuPomoWorkEnd
{
	_cycle = unyu_cycle
	_count = unyu_cyclecount
	_diff  = UnyuCycleDiffByte
	_long  = (_cycle % unyu_pomo_sets == 0)

	unyu_worktotal += unyu_limitmin
	if _long {
		unyu_breakmin = unyu_pomo_long
	}
	else {
		unyu_breakmin = unyu_pomo_break
	}
	unyu_phase     = 'break'
	unyu_phasetick = GETTICKCOUNT
	unyu_breaksave = 0

	'\0\s[0]'
	--
	UnyuSound('end')
	--
	"%(HAN2ZEN(_cycle,'num'))回目、\w5おしまいや。\w9\n"
	--
	if _count <= 0 {
		'更新はなかったけど、\w5考えとった時間も作業のうちや。\w9\n'
	}
	elseif _diff > 0 {
		"更新%(HAN2ZEN(_count,'num'))回、\w5%(UnyuSizeText(_diff))増えたで。\w9\n"
	}
	elseif _diff < 0 {
		"更新%(HAN2ZEN(_count,'num'))回、\w5%(UnyuSizeText(_diff))減ったで。\w9\n"
	}
	else {
		"更新%(HAN2ZEN(_count,'num'))回、\w5サイズはそのままや。\w9\n"
	}
	--
	if _long {
		"ここまで%(HAN2ZEN(_cycle,'num'))回、\w5ようやったな。\w9\n長めに%(HAN2ZEN(unyu_breakmin,'num'))分、\w5休も。\e"
	}
	else {
		"ほな、\w5%(HAN2ZEN(unyu_breakmin,'num'))分休憩や。\e"
		"%(HAN2ZEN(unyu_breakmin,'num'))分、\w5ひと休みしよか。\e"
	}
}

//------------------------------------------------------------------------------
// 休憩が明けた（UnyuPomoNextAsk の頭に付ける）
//------------------------------------------------------------------------------
UnyuBreakEndNotice : nonoverlap
{
	'休憩、\w5終わりやで。\w9\n'
	'はい、\w5休憩おしまいや。\w9\n'
	'そろそろ、\w5ええ頃やな。\w9\n'
}

//------------------------------------------------------------------------------
// 休憩明けの確認。次へ行くか、ここで終わるか
// 選択肢が消えても、ダブルクリックでここへ戻る（UnyuRunningMenu）
// _argv[0] は最初の一言
//------------------------------------------------------------------------------
UnyuPomoNextAsk
{
	_next = unyu_cycle + 1

	'\0\s[0]'
	--
	_argv[0]
	--
	"次は%(HAN2ZEN(_next,'num'))回目やな。\w9\nいけそうか？"
	--
	AYATEMPLATE.MenuItem("次いこか","UnyuPomoNext",200)
	--
	AYATEMPLATE.MenuItem("ここで終わる","UnyuPomoQuit")
	--
	'\e'
}

//------------------------------------------------------------------------------
// 休憩中のダブルクリック
//------------------------------------------------------------------------------
UnyuPomoBreakReport
{
	_rest = unyu_breakmin - UnyuPhaseMin

	if _rest < 1 {
		_rest = 1
	}

	'\0\s[0]'
	--
	"休憩中やで。\w9\nあと%(HAN2ZEN(_rest,'num'))分くらいや。"
	--
	AYATEMPLATE.MenuItem("まだ休む","UnyuPomoKeepBreak",200)
	--
	AYATEMPLATE.MenuItem("休憩を切り上げる","UnyuPomoNext")
	--
	AYATEMPLATE.MenuItem("ここで終わる","UnyuPomoQuit")
	--
	AYATEMPLATE.MenuItem("しゃべり頻度を変えて","Menu_TALKINTERVAL",150)
	--
	'\e'
}

UnyuPomoKeepBreak
{
	'\0\s[0]せやな、\w5ゆっくりしとき。\e'
	'\0\s[0]おう。\w9\n時間になったら呼ぶわ。\e'
}

//------------------------------------------------------------------------------
// 休憩中に保存されたときのつっこみ（エディタの自動保存かもしれないので軽く）
//------------------------------------------------------------------------------
UnyuBreakSaveTalk
{
	'\0\s[0]ん、\w5今ファイル動いたな？\w9\n自動保存やったらええけど、\w5休憩中やで。\e'
	'\0\s[0]休憩中に保存しとらんか？\w9\n…\w5…\w5まあ、\w5勝手に保存されることもあるわな。\e'
	'\0\s[0]休むときは休むんやで。\w9\n…\w5…\w5自動保存やったら、\w5堪忍な。\e'
}

//------------------------------------------------------------------------------
// ここで終わる。全部の合計を報告する
// 休憩中の保存は回数に入らないが、サイズの差には入る（開始時と今の差なので）
//------------------------------------------------------------------------------
UnyuPomoQuit
{
	//---- 古い選択肢を押されたときは、何もしない
	if !unyu_running {
		return ''
	}

	_min  = unyu_worktotal
	_done = unyu_cycle
	if unyu_phase == 'work' {
		_min  += UnyuPhaseMin
		_done -= 1
	}
	_count = unyu_count
	_diff  = UnyuDiffByte

	unyu_running = 0
	unyu_phase   = ''

	UnyuFileWatchCancel
	--
	'\0\s[0]'
	--
	if _min <= 0 {
		'まだ始まったばっかりやったな。\w9\nまた気が向いたら呼んでな。\e'
	}
	elseif _done > 0 {
		"%(HAN2ZEN(_done,'num'))回ぶん、\w5歩いたで。\w9\n"
		--
		UnyuReportTalk(_min,_count,_diff,UnyuMostTouchedTalk)
	}
	else {
		UnyuReportTalk(_min,_count,_diff,UnyuMostTouchedTalk)
	}
}

//------------------------------------------------------------------------------
// 休憩中のランダムトーク（座って休んでいる）
// 作業中と同じく、状況を断定する台詞は書かない
//------------------------------------------------------------------------------
UnyuBreakTalk : nonoverlap
{
	'\0\s[0]'
	--
	'ワイも座って休んどるで。\w9\n足、\w5ちょっと伸ばしとこ。'
	'休憩中は、\w5画面から目ぇ離しとき。'
	'水でも飲んどき。\w9\nワイはもう飲んだで。'
	'立って伸びでもしとき。\w9\nちょっとだけでもちゃうで。'
	'カラカラいわんと、\w5静かやな。'
	'休むのも、\w5作業のうちやで。'
	--
	'\e'
}

//------------------------------------------------------------------------------
// 休憩明けの確認を待っているときのランダムトーク
//------------------------------------------------------------------------------
UnyuWaitTalk
{
	'\0\s[0]休憩、\w5終わっとるで。\w9\nワイをダブルクリックしたら、\w5続きいけるで。\e'
	'\0\s[0]まだ休んどるんか？\w9\nええけど、\w5いけそうならワイをダブルクリックしてな。\e'
}
