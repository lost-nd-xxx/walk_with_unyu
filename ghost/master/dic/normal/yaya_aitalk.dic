//******************************************************************************
// YAYA　ゴーストテンプレート
// トーク辞書
//******************************************************************************


//******************************************************************************
// ランダムトーク
//******************************************************************************
RandomTalk
{
	//---- 作業中は作業用のトークに差し替える
	if unyu_running {
		return UnyuWorkTalk
	}

	TOSTR(EVAL(CHR(0x22)+REPLACE(RandomTalkEx(),CHR(0x22),CHR(0x22)+CHR(0x22))+CHR(0x22)))
}

//------------------------------------------------------------------------------
//ランダムトーク本体：この中にランダムトークを記載してください
//ここのみ常に ' ' で括って書いてください。
//上のRandomTalkの中身で%( )を展開していますので、" "を使わなくてもOKです。
//高速化対策
//------------------------------------------------------------------------------
RandomTalkEx : nonoverlap
{
	'\0\s[0]'
	--
	//---- 自分のことなど
	'段々、関西弁がようわからんくなってきたな…\w5…\w5。\w9\nワイのは、\w5猛虎弁、\w5っちゅうやつかもしれん。'
	'この回し車な、\w5ワイが回すときだけ回るんよ。\w9\n当たり前やな。\w9\n…\w5…\w5当たり前やんな？'
	'ワイ、\w5この回し車から降りたことないねん。\w9\n降りたらどうなるんやろな。\w9\nまあ、\w5試さんけど。'
	'歩いても歩いても、\w5景色が変わらんのよ。\w9\nそういう日もあるやろ。\w9\nワイの場合は、\w5そういう日ばっかりやな。'
	'ワイの仕事はな、\w5歩くことやのうて、\w5\n見守ることやと思うとる。\w9\n歩くんはおまけや。'
	'たまに自分でも、\w5なんで回っとるんか\n分からんようになるんよ。\w9\nまあ、\w5ええか。'
	//---- ユーザーへ
	'%(username)、\w5根詰めすぎとらんか。'
	'%(username)が休んどるときはな、\w5\nワイもちょっと休んどるんよ。\w9\n内緒やで。'
	'ワイは%(username)の進み具合を、\w5数える係や。\w9\n急かす係とちゃうからな。\w9\nそこは間違えんといてな。'
	'手ぇ止まっとっても、\w5ワイは責めへんよ。\w9\n止まる時間も要るやろ。'
	//---- 作業や進捗について
	'進捗ってな、\w5増えた分だけやないと思うんよ。\w9\n消した分も、\w5ちゃんと進んどる。'
	'一気に進む日と、\w5全然あかん日があるやろ。\w9\n均して見たら、\w5だいたい進んどるもんや。'
	'完璧に仕上げようとすると、\w5一歩も動けんようになる。\w9\nワイくらい雑でええんとちゃうか。'
	'始めるんが一番しんどいんよな。\w9\n歩き出してまえば、\w5勢いがついてちょっと楽になる、\w5\n…\w5…\w5かもしれん。'
	'やる気って、\w5待っとっても来んらしいで。\w9\n動いとると、\w5後から付いてくるんやと。'
	//---- 時間や日常
	'時間が経つのは早いな。\w9\nワイはずっと同じとこ歩くだけやのに。'
	'水、飲んどるか。\w9人間はそれ忘れるやろ。\w9\nワイは飲まんけど。'
	'肩な、\w5回しとき。\w9固まってまうで。'
	'画面ばっかり見とったら、\w5目ぇ疲れるで。\w9\nたまにはワイを見とき。\w9\n…\w5…\w5ワイも画面の中か。'
	//---- メタなこと
	'ワイ、\w5歩くことと見守ることしかできんのよ。\w9\nあと、喋るのもできるな。\w9\nまあ、\w5できることが少しあるだけええか。'
	'ワイに表情っちゅうもんは無いねん。\w9\n見せられるんは、\w5座っとるか、\w5歩いとるか、\w5\n留守にしとるか。\w9\nその三つだけや。'
	'ワイはうにゅう族やけど、\w5刮目はせえへんで。\w9\n表情差分に入っとらんからな。'
	'サーフェスの番号な、\w5百番台はぜんぶ歩く部品なんよ。\w9\n歩く動きが一コマずつ入っとる。\w9\n…\w5…\w5ワイは、\w5パラパラ漫画みたいなもんなんや。'
	'ワイのシェルの背景な、\w5着せ替えになっとるねん。\w9\n明るいのと暗いのを切り替えられるんや。\w9\n無しにもできるで。'
	--
	'\e'
}

//******************************************************************************
//キーが押された
//******************************************************************************
/*
//------------------------------------------------------------------------------
//OnKeyPressイベント
//------------------------------------------------------------------------------
//キーボードの任意のキーが押されたときに発動するイベントです。
//ファンクションキーを指定するときは、'f1'等と指定します。
//押されたキーはreference0に格納されます。
//if文、もしくはcase~when文で分岐させると良いでしょう。
*/

OnKeyPress
{
	case reference0 {
		when 't' {
			'\![raise,OnAiTalk]'
		}
		when 'm' {
			if unyu_running {
				UnyuProgressReport
			}
			else {
				OpenMenu
			}
		}
	}
}

//******************************************************************************
//時報
//******************************************************************************

//------------------------------------------------------------------------------
//OnHourTimeSignalイベント
//------------------------------------------------------------------------------

OnHourTimeSignal
{
	//---- 日付が変わったときのみ喋る
	if hour == 0 {
		"\0\s[0]日付が変わって、%(month)月%(day)日%(ANY('やで','やね','やな'))。"
	}
	--
	'\e'
}

//------------------------------------------------------------------------------
//OnSecondChangeイベント
//1 秒毎に実行される。ここではあまり重い処理を行わないこと
//---------------------------------------------------------------------------
OnSecondChange
{
	//---- 作業セッションの時間を見る
	UnyuTick
}

//******************************************************************************
//サーフィス復元
//******************************************************************************

//------------------------------------------------------------------------------
//OnSurfaceRestoreイベント
//------------------------------------------------------------------------------
OnSurfaceRestore
{
	DefaultSurface + '\e'
}

DefaultSurface
{
	if unyu_running {
		'\1\s[10]\0\s[1]'
	}
	else {
		'\1\s[10]\0\s[0]'
	}
}

