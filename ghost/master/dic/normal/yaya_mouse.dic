//******************************************************************************
// YAYA　ゴーストテンプレート
// マウス入力関連辞書
//******************************************************************************

//******************************************************************************
//マウス処理部
//
//以下、実際のトークを記述します。関数名は以下の規則になっています。
//[種別] + [スコープ] + [部位]
//種別は、MouseMove, MouseDoubleClick, MouseWheelUp, MouseWheelDown のどれかです。
//スコープは、\0,\1,といったスコープ番号です。
//部位は、当たり判定のどの部位かを表します。当たり判定の無い場所でのイベントの場合
//部位はありません。
//******************************************************************************

//--------------------------------
// うにゅうのオノマトペ
//--------------------------------
UnyuOnomatopoeia : nonoverlap
{
	'ごつごつ'
	'ごわごわ'
	'さすさす'
	'さらさら'
	'ざらざら'
	'しわしわ'
	'そよそよ'
	'たゆたゆ'
	'つるつる'
	'てらてら'
	'てろてろ'
	'ぬめぬめ'
	'ぬらぬら'
	'ねとねと'
	'ぴかぴか'
	'ぴこぴこ'
	'ふさふさ'
	'ふにふに'
	'ふよふよ'
	'ぷにぷに'
	'ぷりぷり'
	'べたべた'
	'ぺたぺた'
	'ほむほむ'
	'むにむに'
	'もけもけ'
	'もこもこ'
	'もにもに'
	'もふもふ'
	'もよもよ'
}

//******************************************************************************
//撫で反応
//******************************************************************************
MouseMove0Unyu : nonoverlap
{
	if unyu_running {
		//作業中なら反応しない
		return
	}
	
	'\0\s[0]'
	--
	//---- オノマトペを使うもの
	"%(UnyuOnomatopoeia)。"
	"ワイの%(UnyuOnomatopoeia)ボディ、どうや？"
	"%(UnyuOnomatopoeia)…\w5…\w5。\w9\n今はそういう触り心地らしいわ。"
	"お、\w5%(UnyuOnomatopoeia)しとるな。\w9\n自分では分からんもんやな。"
	"%(UnyuOnomatopoeia)やろ。\w9\n…\w5…\w5前とちゃう気ぃするけど、\w5気のせいか。"
	//---- 撫でられること自体について
	'摩擦熱で発火してまう…\w5…\w5にはまだ遠いか。'
	'撫でても、\w5歩く速さは変わらんで。'
	'そんなに撫でて、\w5楽しいか。\w9\n…\w5…\w5まあ、\w5ええけど。'
	'ワイ、\w5撫でられるために置いてあるんとちゃうねんけどな。\w9\n…\w5…\w5もうちょいええで。'
	'手ぇ、\w5あったかいな。'
	'くすぐったいわ。\w9\nやめろとは言わんけど。'
	//---- ユーザーへ
	"%(username)、\w5手ぇ空いとるんか。\w9\nええこっちゃ。"
	'こうしとる時間も、\w5無駄とちゃうと思うで。'
	'休憩中か。\w9\nほな、\w5付き合うたるわ。'
	--
	'\e'
}

//******************************************************************************
//つつかれ反応
//******************************************************************************

//本体側のつつかれ反応
MouseDoubleClick0
{
	//作業中なら途中報告、待機中なら作業を始めるか尋ねる
	if unyu_running {
		UnyuProgressReport
	}
	else {
		OpenMenu
	}
}

//******************************************************************************
//マウス処理部コア
//AYATEMPLATE.MouseMoveWheelFuncの2番目の数字が「感度」です。
//1番目の数字（0か1）は、MoveかWheelかを判別するためのもので、
//変更の必要はありません。
//******************************************************************************

OnMouseMove
{
	AYATEMPLATE.MouseMoveWheelFunc(0,50,'MouseMove')
}

OnMouseWheel
{
	_result = ''
	if TOINT(reference[2]) > 0 {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheelUp')
	}
	else {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheelDown')
	}

	if _result == '' {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheel')
	}

	_result
}

OnMouseDoubleClick
{
	AYATEMPLATE.MouseEventExec('MouseDoubleClick')
}
