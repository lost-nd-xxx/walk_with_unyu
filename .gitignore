/etc/tama.txt

# nar とビルドの出力
*.nar
/build/

# AI エージェント（ukagaka-developer スキル）と開発用の文書。リポジトリには置かない
/AGENTS.md
/CLAUDE.md
/GHOST.md
/.mcp.json
